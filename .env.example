# Supabase (Project Settings → API). Never put the service-role key here – the app does not use it.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>
# Optional: used for e-mail links (magic link / confirmation). Defaults to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI – server only
OPENAI_API_KEY=
# Optional model overrides
OPENAI_MODEL=gpt-5.5
OPENAI_MODEL_FAST=gpt-5.4-mini
